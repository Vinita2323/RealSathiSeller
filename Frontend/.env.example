# ==============================================================================
# Sathi Seller Frontend Environment Configuration (Example Template)
# ==============================================================================
# Copy this file to .env before starting the frontend development server:
#   cp .env.example .env
#
# NOTE: All Vite variables MUST start with the VITE_ prefix to be exposed to client-side code.
# NEVER put backend secrets (JWT_SECRET, RAZORPAY_KEY_SECRET, Database credentials) in this file!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Base URL
# ------------------------------------------------------------------------------
# In local development: http://localhost:5000
# In production: https://your-production-domain.com
VITE_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. Razorpay Public Key ID (Client-side Checkout Modal)
# ------------------------------------------------------------------------------
# Only the public Key ID is required here (e.g. rzp_test_... or rzp_live_...)
# DO NOT include RAZORPAY_KEY_SECRET in the frontend!
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# ------------------------------------------------------------------------------
# 3. Google Maps JavaScript API
# ------------------------------------------------------------------------------
# Requires Maps JavaScript API, Places API, Geocoding API, and Distance Matrix API enabled
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 4. Firebase Cloud Messaging (Web Push Notifications)
# ------------------------------------------------------------------------------
# Obtain these credentials from: Firebase Console -> Project Settings -> General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_web_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Web Push Certificate (VAPID Key) from:
# Firebase Console -> Project Settings -> Cloud Messaging -> Web configuration -> Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key_here
