# ==============================================================================
# Sathi Seller Backend Environment Configuration (Example Template)
# ==============================================================================
# Copy this file to .env before starting the backend:
#   cp .env.example .env
#
# DO NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=7000
NODE_ENV=development
APP_NAME="Sathi Seller"
LOG_API_TIMINGS=false

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# For Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/sathiseller
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sathiseller?retryWrites=true&w=majority

# Optional: Set to true to automatically build missing MongoDB indexes on startup
SYNC_INDEXES_ON_STARTUP=false

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Generate a secure 64+ character random string for production
JWT_SECRET=your_jwt_secret_development_key_change_in_production

# ------------------------------------------------------------------------------
# 4. Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
# Get your API keys from: Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook Secret from: Razorpay Dashboard -> Settings -> Webhooks
# Used for server-to-server webhook signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. SMS Gateway & OTP (SMS India Hub - DLT Approved Gateway)
# ------------------------------------------------------------------------------
# SMS_PROVIDER_MODE options:
#   - sandbox / test: Simulates OTP dispatch and logs OTP to console (safe for local dev)
#   - live: Dispatches actual SMS via SMS India Hub API
SMS_PROVIDER_MODE=sandbox
SMS_INDIA_HUB_API_KEY=your_sms_india_hub_api_key_here
SMS_INDIA_HUB_SENDER_ID=BGADEC
SMS_INDIA_HUB_TEMPLATE_ID=1007282516644508833
SMS_INDIA_HUB_ENTITY_ID=your_dlt_principal_entity_id_here
SMS_INDIA_HUB_API_URL=https://cloud.smsindiahub.in/vendorsms/pushsms.aspx
SMS_INDIA_HUB_APP_NAME="Sathi Seller"

# ------------------------------------------------------------------------------
# 6. Media Storage (Cloudinary - Optional, Fallback is Local File Storage)
# ------------------------------------------------------------------------------
# If Cloudinary credentials are not provided, files are stored locally in Backend/uploads/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ------------------------------------------------------------------------------
# 7. Push Notifications (Firebase Admin SDK / FCM)
# ------------------------------------------------------------------------------
# Option A: Path to service account JSON (recommended for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json

# Option B: Individual environment variables
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_ID=
FIREBASE_PRIVATE_KEY_ID=

# Option C: Entire service account JSON content as a single line string
# FIREBASE_CONFIG={"type":"service_account",...}
